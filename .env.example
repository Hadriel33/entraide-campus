# Copier en .env.local (jamais commité). En ligne : variables du projet Vercel.
# Publiques (protégées par la RLS) :
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# IA : aucune clé. Vercel AI Gateway utilise le jeton OIDC du projet (VERCEL_OIDC_TOKEN, fourni par `vercel env pull`).
# Serveur uniquement : clé secrète Supabase (sb_secret_...), utilisée SEULEMENT pour écrire la modération IA.
# Jamais de préfixe NEXT_PUBLIC_. Sans elle, les annonces restent « en attente » d'un admin.
SUPABASE_SECRET_KEY=
